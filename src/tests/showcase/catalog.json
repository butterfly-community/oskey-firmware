{
  "sections": [
    {
      "id": "start",
      "title": "从开机到模块总览",
      "summary": "设备能力总览、钱包与通行密钥首页，以及按需组合的连接和外设模块。",
      "description": "开机即可查看设备能力，进入钱包与通行密钥首页，再按使用习惯选择连接和外设模块。"
    },
    {
      "id": "wallet",
      "title": "创建、恢复与解锁钱包",
      "summary": "钱包创建与恢复，12 / 18 / 24 词助记词、备份验证、口令保护与 PIN 解锁。",
      "description": "从 PIN 创建到助记词备份，完整呈现钱包初始化、12 / 18 / 24 词选择、短语验证、导入、口令与触摸解锁的操作流程。"
    },
    {
      "id": "entropy",
      "title": "让随机性来自你的世界",
      "summary": "硬件随机数、触摸、运动、摄像头和环境声音多源熵混合，支持自定义熵。",
      "description": "硬件随机数与触摸轨迹、设备运动、摄像头画面和环境声音一起参与熵混合；也可以逐位设置自定义熵。"
    },
    {
      "id": "ethereum",
      "title": "地址派生、消息与交易签名",
      "summary": "HD 地址派生与二维码、以太坊消息和交易签名，以及设备端交易审阅与授权。",
      "description": "查看 HD 派生路径和地址二维码，在设备上审阅以太坊消息、收款地址、金额与网络。签名前确认私钥访问，随后查看公钥、哈希和签名结果。"
    },
    {
      "id": "airgap",
      "title": "用二维码完成气隙签名",
      "summary": "通过二维码传递交易请求与签名结果，在设备上完成扫描、审阅、确认与签名。",
      "description": "钱包应用展示请求二维码，OSKey 扫描并在屏幕上确认交易，签名结果再通过二维码回到钱包应用。三个画面串起完整的交互过程。"
    },
    {
      "id": "fido",
      "title": "以 Google 为例的 FIDO2 身份认证",
      "summary": "FIDO2 通行密钥注册与登录、用户在场确认、权限授权和 PIN 管理；以 www.google.com 为例。",
      "description": "以 www.google.com 为服务、demo@example.com 为账号，展示通行密钥注册、登录签名、用户在场确认、权限授权与 PIN 管理。每一次私钥操作都在设备屏幕上确认。"
    },
    {
      "id": "nxp",
      "title": "NXP A5000 安全芯片管理",
      "summary": "A5000R2HQ1 seed 安全存储、PIN 解锁、重试次数保护、锁定与钱包清除。",
      "description": "A5000R2HQ1 为 seed 提供安全存储。专属页面呈现初始化、钱包锁定与 PIN 解锁、次数保护、连接刷新和钱包清除，让安全芯片的状态与操作一目了然。"
    },
    {
      "id": "connectivity",
      "title": "连接你的设备与应用",
      "summary": "Wi-Fi 扫描与配网、蓝牙加密连接与地址隐私、WebUSB / FIDO2，以及 MQTT 消息通信。",
      "description": "Wi-Fi 提供网络扫描、密码输入、热点配网与地址信息；蓝牙提供发现、加密连接和地址隐私；USB 汇集 WebUSB 与 FIDO2；MQTT 将设备状态与消息带入应用。"
    },
    {
      "id": "camera",
      "title": "摄像头与二维码",
      "summary": "摄像头预览、二维码识别，以及地址与交互请求读取。",
      "description": "从摄像头状态进入扫码预览，识别地址或交互请求，直接在屏幕上查看二维码内容和识别耗时。"
    },
    {
      "id": "audio",
      "title": "声音也是一种交互",
      "summary": "提示音播放、扬声器音量调节与麦克风输入电平。",
      "description": "播放提示音、调节扬声器音量，查看麦克风输入电平，让听觉反馈和环境声音成为设备的一部分。"
    },
    {
      "id": "imu",
      "title": "把设备运动变成可见姿态",
      "summary": "六轴运动采集、姿态融合与立体模型实时显示。",
      "description": "六轴加速度与陀螺仪数据经过姿态融合，在屏幕上变成随设备倾斜转动的立体模型。"
    },
    {
      "id": "storage",
      "title": "浏览随身文件",
      "summary": "SD 卡目录浏览、文件信息查看与目录切换。",
      "description": "通过 SD 卡文件浏览器查看目录、文件名与文件大小，在根目录和子目录之间自由切换。"
    },
    {
      "id": "update",
      "title": "签名固件更新",
      "summary": "蓝牙 / UART 固件传输、MCUboot 签名校验、版本保护与更新重启。",
      "description": "通过蓝牙或 UART 传输固件，展示 MCUboot 签名校验、版本保护、更新进度与重启应用的流程。"
    },
    {
      "id": "maintenance",
      "title": "设备维护",
      "summary": "设备重启、数据清除、存储恢复与敏感操作确认。",
      "description": "重启、清除设备数据和存储恢复操作集中呈现，敏感操作在设备上再次确认。"
    }
  ],
