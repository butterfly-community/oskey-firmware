{
  "sections": [
    {
      "id": "start",
      "title": "从开机到模块总览",
      "summary": "设备能力总览、可选安全启动与 Flash 加密、触摸与实体按键交互。",
      "description": "开机即可查看设备能力，进入钱包与通行密钥首页，再按使用习惯选择连接和外设模块。可选安全启动验证固件来源，Flash 加密保护设备内的持久化数据；触摸屏与实体按键提供设备端确认，让不同形态的硬件都能承载你的选择。"
    },
    {
      "id": "wallet",
      "title": "创建、恢复与解锁钱包",
      "summary": "钱包创建与恢复、12 / 18 / 24 词助记词、口令与 PIN 保护，以及按需选择的 seed 存储后端。",
      "description": "从 PIN 创建到助记词备份，完整呈现钱包初始化、12 / 18 / 24 词选择、短语验证、导入、口令与触摸解锁的操作流程。seed 可采用软件加密存储，也可交给 NXP 安全芯片管理；根据硬件方案选择存储后端，使用同一套钱包功能。"
    },
    {
      "id": "entropy",
      "title": "让随机性来自你的世界",
      "summary": "硬件随机数、触摸、运动、摄像头和环境声音多源熵混合，支持自定义熵。",
      "description": "硬件随机数与触摸轨迹、设备运动、摄像头画面和环境声音一起参与熵混合；也可以逐位设置自定义熵。"
    },
    {
      "id": "ethereum",
      "title": "地址派生、消息与交易签名",
      "summary": "HD 地址派生与二维码、以太坊消息和交易签名，以及设备端交易审阅与授权。",
      "description": "查看 HD 派生路径和地址二维码，在设备上审阅以太坊消息、收款地址、金额与网络。签名前确认私钥访问，随后查看公钥、哈希和签名结果。"
    },
    {
      "id": "airgap",
      "title": "用二维码完成气隙签名",
      "summary": "通过二维码传递交易请求与签名结果，在设备上完成扫描、审阅、确认与签名。",
      "description": "钱包应用展示请求二维码，OSKey 扫描并在屏幕上确认交易，签名结果再通过二维码回到钱包应用。三个画面串起完整的交互过程。"
    },
    {
      "id": "fido",
      "title": "以 Google 为例的 FIDO2 身份认证",
      "summary": "FIDO2 通行密钥、OpenSSH 硬件密钥、驻留凭据与独立 FIDO PIN 管理。",
      "description": "以 www.google.com 为服务、demo@example.com 为账号，展示通行密钥注册、登录签名、用户在场确认与权限授权。私钥操作通过设备端确认完成，同时支持 OpenSSH 硬件密钥与驻留通行密钥。FIDO PIN 与钱包 PIN 独立管理，可通过 USB 主机设置和修改，并在设备上恢复尝试次数。"
    },
    {
      "id": "nxp",
      "title": "NXP A5000 安全芯片管理",
      "summary": "A5000R2HQ1 seed 安全存储、PIN 解锁、重试次数保护、锁定与钱包清除。",
      "description": "NXP A5000 安全芯片可按需选配，由 A5000R2HQ1 为 seed 提供安全存储。专属页面呈现初始化、钱包锁定与 PIN 解锁、连接刷新和钱包清除。芯片执行十次 PIN 尝试限制，锁定状态跨重启保持，清除钱包后即可重新初始化。"
    },
    {
      "id": "connectivity",
      "title": "连接你的设备与应用",
      "summary": "Wi-Fi、蓝牙、WebUSB、UART 与 MQTT 通信，以及浏览器配网和设备管理。",
      "description": "Wi-Fi 提供网络扫描、密码输入、热点配网与地址信息；蓝牙提供发现、加密连接和地址隐私；WebUSB、蓝牙与 UART 使用统一的钱包通信协议，USB 同时提供 FIDO2 身份认证；MQTT 将设备状态与消息带入应用。在浏览器中打开设备管理页面，即可配置 Wi-Fi、设置设备主机名和远程重启，让设备自然融入你的网络与工作环境。"
    },
    {
      "id": "camera",
      "title": "摄像头与二维码",
      "summary": "摄像头预览、二维码识别，以及地址与交互请求读取。",
      "description": "从摄像头状态进入扫码预览，识别地址或交互请求，直接在屏幕上查看二维码内容和识别耗时。"
    },
    {
      "id": "audio",
      "title": "声音也是一种交互",
      "summary": "提示音与音量调节、USB 双声道录音、采样率选择与麦克风隐私控制。",
      "description": "播放提示音、调节扬声器音量，让听觉反馈成为设备的一部分。USB 麦克风提供双声道 16-bit PCM 录音，支持由主机选择 16 / 32 / 48 kHz 采样率。设备端隐私开关掌握采音时机，关闭时 USB 录音接口提供静音；环境声音也可参与钱包的熵混合。"
    },
    {
      "id": "imu",
      "title": "把设备运动变成可见姿态",
      "summary": "六轴运动采集、姿态融合与立体模型实时显示。",
      "description": "六轴加速度与陀螺仪数据经过姿态融合，在屏幕上变成随设备倾斜转动的立体模型。"
    },
    {
      "id": "storage",
      "title": "浏览随身文件",
      "summary": "FAT16 / FAT32 / exFAT 只读浏览、文件信息、目录导航与内部存储完整性校验。",
      "description": "通过 SD 卡文件浏览器查看目录、文件名与文件大小，在根目录和子目录之间自由切换。支持 FAT16、FAT32 和 exFAT，以只读方式浏览随身文件。内部存储提供完整性校验，钱包记录与设备设置分别管理，SD 卡文件浏览与钱包内部存储各自独立。"
    },
    {
      "id": "update",
      "title": "签名固件更新",
      "summary": "蓝牙 / UART / 浏览器固件更新、签名校验、版本保护、启动确认与自动回滚。",
      "description": "通过蓝牙、UART 或浏览器上传签名固件，查看更新进度并重启应用。MCUboot 校验固件签名并提供版本保护，设备在新固件成功启动后确认更新，自动回滚机制为版本切换提供恢复保障。"
    },
    {
      "id": "maintenance",
      "title": "设备维护",
      "summary": "设备重启、数据清除、存储恢复、设置持久化与敏感操作确认。",
      "description": "重启、清除设备数据和存储恢复操作集中呈现，敏感操作在设备上再次确认。钱包配置、网络设置与蓝牙配对信息持久保存，重启后保留钱包与连接配置。"
    }
  ],
