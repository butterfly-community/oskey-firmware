# LVGL software vector rendering: use the draw buffer's absolute origin when
# mapping a partial refresh area into ThorVG's local canvas.

diff --git a/src/draw/sw/lv_draw_sw_vector.c b/src/draw/sw/lv_draw_sw_vector.c
--- a/src/draw/sw/lv_draw_sw_vector.c
+++ b/src/draw/sw/lv_draw_sw_vector.c
@@ -510,7 +510,7 @@ void lv_draw_sw_vector(lv_draw_task_t * t, lv_draw_vector_dsc_t * dsc)
 
     _tvg_rect rc;
     lv_area_to_tvg(&rc, &t->clip_area);
-    tvg_canvas_set_viewport(canvas, (int32_t)rc.x, (int32_t)(rc.y - layer->partial_y_offset), (int32_t)rc.w, (int32_t)rc.h);
+    tvg_canvas_set_viewport(canvas, (int32_t)rc.x, (int32_t)(rc.y - layer->buf_area.y1), (int32_t)rc.w, (int32_t)rc.h);
 
     _tvg_draw_state state = {canvas, layer->partial_y_offset, -layer->buf_area.x1, -layer->buf_area.y1, t->opa};

# Apply LVGL image recolor to solid SVG fills and strokes. The SVG decoder
# submits vector tasks directly, bypassing the normal bitmap recolor path.

diff --git a/src/libs/svg/lv_svg_decoder.c b/src/libs/svg/lv_svg_decoder.c
--- a/src/libs/svg/lv_svg_decoder.c
+++ b/src/libs/svg/lv_svg_decoder.c
@@ -11,6 +11,7 @@
 
 #include "lv_svg_decoder.h"
 #include "lv_svg_render.h"
+#include "../../draw/lv_draw_vector_private.h"
 #include "../../draw/lv_draw_buf_private.h"
 #include "../../display/lv_display_private.h"
 
@@ -342,6 +343,28 @@ static void svg_draw_buf_free(void * svg_buf)
     lv_svg_render_delete(draw_list);
 }
 
+static lv_color32_t svg_recolor(lv_color32_t color, lv_color_t recolor, lv_opa_t opa)
+{
+    lv_color_t mixed = lv_color_mix(recolor, lv_color_make(color.red, color.green, color.blue), opa);
+    return lv_color_to_32(mixed, color.alpha);
+}
+
+static void svg_recolor_tasks(lv_draw_vector_dsc_t * dsc, lv_color_t recolor, lv_opa_t opa)
+{
+    if(opa <= LV_OPA_MIN || dsc->task_list == NULL) return;
+
+    lv_draw_vector_subtask_t * task = lv_ll_get_head(dsc->task_list);
+    while(task) {
+        if(task->ctx.fill_dsc.style == LV_VECTOR_DRAW_STYLE_SOLID) {
+            task->ctx.fill_dsc.color = svg_recolor(task->ctx.fill_dsc.color, recolor, opa);
+        }
+        if(task->ctx.stroke_dsc.style == LV_VECTOR_DRAW_STYLE_SOLID) {
+            task->ctx.stroke_dsc.color = svg_recolor(task->ctx.stroke_dsc.color, recolor, opa);
+        }
+        task = lv_ll_get_next(dsc->task_list, task);
+    }
+}
+
 static void svg_draw(lv_layer_t * layer, const lv_image_decoder_dsc_t * decoder_dsc, const lv_area_t * coords,
                      const lv_draw_image_dsc_t * image_dsc, const lv_area_t * clip_area)
 {
@@ -375,6 +397,7 @@ static void svg_draw(lv_layer_t * layer, const lv_image_decoder_dsc_t * decoder_
     }
     lv_draw_vector_dsc_set_transform(dsc, &matrix);
     lv_draw_svg_render(dsc, list);
+    svg_recolor_tasks(dsc, image_dsc->recolor, image_dsc->recolor_opa);
     lv_draw_vector(dsc);
     lv_draw_vector_dsc_delete(dsc);
 
 
