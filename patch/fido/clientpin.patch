+static int utf8_count(const uint8_t *text, size_t len)
+{
+	size_t offset = 0;
+	int count = 0;
+
+	while (offset < len) {
+		uint8_t first = text[offset++];
+		size_t continuation;
+
+		if (first <= 0x7f) {
+			continuation = 0;
+		} else if (first >= 0xc2 && first <= 0xdf) {
+			continuation = 1;
+		} else if (first >= 0xe0 && first <= 0xef) {
+			if (offset >= len || (first == 0xe0 && text[offset] < 0xa0) ||
+			    (first == 0xed && text[offset] >= 0xa0)) {
+				return -EINVAL;
+			}
+			continuation = 2;
+		} else if (first >= 0xf0 && first <= 0xf4) {
+			if (offset >= len || (first == 0xf0 && text[offset] < 0x90) ||
+			    (first == 0xf4 && text[offset] >= 0x90)) {
+				return -EINVAL;
+			}
+			continuation = 3;
+		} else {
+			return -EINVAL;
 		}
-	} else if (protocol == FIDO2_PIN_PROTOCOL_V2) {
-		/* TODO: proto 2 */
-		return -EINVAL;
-	} else {
-		return -EINVAL;
+
+		if (offset + continuation > len) {
+			return -EINVAL;
+		}
+		while (continuation-- > 0) {
+			if ((text[offset++] & 0xc0) != 0x80) {
+				return -EINVAL;
+			}
+		}
+		++count;
 	}
 
-	return 0;
+	return count;
