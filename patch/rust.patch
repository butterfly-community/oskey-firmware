+      set(RUST_TARGET "xtensa-esp32s2-none-elf" PARENT_SCOPE)
+    elseif(CONFIG_SOC_SERIES_ESP32)
+      set(RUST_TARGET "xtensa-esp32-none-elf" PARENT_SCOPE)
