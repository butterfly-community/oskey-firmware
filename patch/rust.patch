diff --git a/zephyr/src/alloc_impl.rs b/zephyr/src/alloc_impl.rs
index 359dde6..39544df 100644
--- a/zephyr/src/alloc_impl.rs
+++ b/zephyr/src/alloc_impl.rs
@@ -57,9 +57,18 @@ use alloc::alloc::handle_alloc_error;
 #[allow(non_camel_case_types)]
 type c_size_t = usize;
 
+#[cfg(CONFIG_RUST_ALLOC_ESP_SPIRAM)]
+const ESP_SPIRAM_THRESHOLD: usize = 128;
+#[cfg(CONFIG_RUST_ALLOC_ESP_SPIRAM)]
+const SMH_REG_ATTR_EXTERNAL: i32 = 2;
+
 extern "C" {
     fn malloc(size: c_size_t) -> *mut u8;
     fn free(ptr: *mut u8);
+    #[cfg(CONFIG_RUST_ALLOC_ESP_SPIRAM)]
+    fn shared_multi_heap_aligned_alloc(attr: i32, align: c_size_t, size: c_size_t) -> *mut u8;
+    #[cfg(CONFIG_RUST_ALLOC_ESP_SPIRAM)]
+    fn shared_multi_heap_free(ptr: *mut u8);
 }
 
 /// An allocator that uses Zephyr's allocation primitives.
@@ -73,6 +82,11 @@ unsafe impl GlobalAlloc for ZephyrAllocator {
         let size = layout.size();
         let align = layout.align();
 
+        #[cfg(CONFIG_RUST_ALLOC_ESP_SPIRAM)]
+        if size > ESP_SPIRAM_THRESHOLD {
+            return shared_multi_heap_aligned_alloc(SMH_REG_ATTR_EXTERNAL, align, size);
+        }
+
         // The C allocation library assumes an alignment of 8.  For now, just panic if this cannot
         // be satistifed.
         if align > 8 {
@@ -83,6 +97,12 @@ unsafe impl GlobalAlloc for ZephyrAllocator {
     }
 
     unsafe fn dealloc(&self, ptr: *mut u8, _layout: Layout) {
+        #[cfg(CONFIG_RUST_ALLOC_ESP_SPIRAM)]
+        if _layout.size() > ESP_SPIRAM_THRESHOLD {
+            shared_multi_heap_free(ptr);
+            return;
+        }
+
         free(ptr)
     }
 }
