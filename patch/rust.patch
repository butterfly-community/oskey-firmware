 				(ARCH_POSIX && 64BIT) || \
 				HEXAGON) && \
 				!TIMER_READS_ITS_FREQUENCY_AT_RUNTIME)
@@ -32,6 +33,13 @@ config RUST_ALLOC
 	  Zephyr allocator (malloc/free).  This this enabled, Rust
 	  applications can use the `alloc` crate.
 
+config RUST_ALLOC_ESP_SPIRAM
+	bool "Allocate large Rust objects from ESP PSRAM"
