menu "OSKey core"

config OSKEY_RUST
	bool "OSKey Rust application"
	default y
	depends on RUST_SUPPORTED
	select RUST
	select RUST_ALLOC
	select PSA_CRYPTO
	select PSA_WANT_ALG_PBKDF2_HMAC
	select PSA_WANT_ALG_SHA_512
	select PSA_WANT_ALG_SHA_256
	select PSA_WANT_ALG_RIPEMD160
	select PSA_WANT_ALG_HMAC
	select PSA_WANT_KEY_TYPE_HMAC
	select PSA_WANT_ALG_DETERMINISTIC_ECDSA
	select PSA_WANT_ALG_ECDSA
	select PSA_WANT_ECC_SECP_K1_256
	select PSA_WANT_ECC_SECP_R1_256
	select PSA_WANT_KEY_TYPE_ECC_PUBLIC_KEY
	select PSA_WANT_KEY_TYPE_ECC_KEY_PAIR_DERIVE
	select PSA_WANT_KEY_TYPE_ECC_KEY_PAIR_IMPORT
	select PSA_WANT_KEY_TYPE_ECC_KEY_PAIR_EXPORT
	select PSA_WANT_KEY_TYPE_CHACHA20
	select PSA_WANT_ALG_CHACHA20_POLY1305
	help
	  Build the OSKey Rust application and its PSA wallet backend.
	  Disable this to build the C application without Rust wallet support.

config OSKEY_MESSAGE_STACK_SIZE
	int "OSKey message thread stack size"
	default 20480 if OSKEY_RUST
	default 2048
	help
	  Stack size for the thread that processes OSKey protocol messages.

endmenu

menu "OSKey features"

config OSKEY_STORAGE
	bool "Storage"
	select ZMS
	select SETTINGS
	select FLASH
	select FLASH_MAP
	select FLASH_PAGE_LAYOUT
	help
	  Enable the shared ZMS storage and Zephyr settings backend.

config MPU_ALLOW_FLASH_WRITE
	default y if OSKEY_STORAGE || OSKEY_XIP

menuconfig OSKEY_DISPLAY
	bool "Display and input"
	select I2C
	select DISPLAY
	select INPUT
	select LVGL
	select LV_Z_AUTO_INIT
	select LV_Z_RUN_LVGL_ON_WORKQUEUE
	select LV_Z_LVGL_MUTEX
	select LV_Z_MEMORY_POOL_CUSTOM_SECTION
	select LV_Z_VDB_CUSTOM_SECTION
	select LV_USE_FONT_COMPRESSED
	select LV_FONT_MONTSERRAT_32
	select LV_FONT_MONTSERRAT_18
	select LV_FONT_MONTSERRAT_16

config MAIN_STACK_SIZE
	default 12288

if OSKEY_DISPLAY

config LV_Z_LVGL_WORKQUEUE_STACK_SIZE
	default 8192

config LV_Z_MEM_POOL_SIZE
	default 81920 if OSKEY_LVGL_BENCHMARK
	default 40960

choice LV_COLOR_DEPTH
	default LV_COLOR_DEPTH_16
endchoice

config OSKEY_LVGL_BENCHMARK
	bool "LVGL benchmark"
	select LV_Z_DEMO_BENCHMARK
	select LV_USE_SYSMON
	select LV_USE_PERF_MONITOR
	select LV_Z_SHELL
	select SHELL

config LV_Z_DEMO_BENCHMARK
	bool "LVGL benchmark demo"
	select LV_USE_DEMO_BENCHMARK
	select LV_USE_DEMO_WIDGETS
	help
	  Build benchmarking demo application.

endif

config OSKEY_BLUETOOTH
