	select BT
	select BT_PERIPHERAL
	select BT_SMP
	select BT_SMP_SC_ONLY
	select BT_APP_PASSKEY
	select BT_ZEPHYR_NUS
	select BT_KEYS_OVERWRITE_OLDEST
	select BT_PRIVACY
	select BT_SETTINGS

