menu "OSKey development options"

config OSKEY_LOG
	bool "Logging"
	select NET_LOG if NETWORKING

config LOG
	default y if OSKEY_LOG
	default n

config BOOT_BANNER
	default n if OSKEY_DEBUG
	default y if OSKEY_LOG
	default n

config OSKEY_DEBUG
	bool "Debugging"
	select DEBUG
	select STACK_USAGE
	select STATS

config OSKEY_TEST_RNG
	bool "Insecure test random generator"
	select TEST_RANDOM_GENERATOR

if OSKEY_TEST_RNG

config MBEDTLS_PSA_CRYPTO_EXTERNAL_RNG_ALLOW_NON_CSPRNG
	default y

choice RNG_GENERATOR_CHOICE
	default TIMER_RANDOM_GENERATOR
endchoice

endif

config OSKEY_ESP_SPIRAM
	bool "ESP32-S3 octal SPI RAM"
	depends on SOC_SERIES_ESP32S3
	select ESP_SPIRAM
	select SPIRAM_FETCH_INSTRUCTIONS
	select SPIRAM_RODATA

if OSKEY_ESP_SPIRAM

choice SPIRAM_MODE
	default SPIRAM_MODE_OCT
endchoice

endif

endmenu

config HW_STACK_PROTECTION
	default y

config STACK_SENTINEL
	default y

