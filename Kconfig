menu "OSKey core"

config OSKEY_MESSAGE_BUS
	bool
	default y
	select NET_BUF
	select ZBUS

config HEAP_MEM_POOL_ADD_SIZE_OSKEY
	int
	default 8192

config OSKEY_TEST_FIRMWARE
	bool "Test firmware"
	depends on OSKEY_RUST
	help
	  Build firmware that automatically approves confirmation requests.
	  This bypasses physical user presence and must never be enabled in
	  production firmware.

config OSKEY_BUS_PAYLOAD_COUNT
	int
	default 8 if OSKEY_RUST
	default 1
	range 1 64

config OSKEY_BUS_PAYLOAD_SIZE
	int
	default 512 if OSKEY_RUST
	default 1
	range 1 65535

config OSKEY_RUST
	bool "OSKey Rust application"
	default y
	depends on RUST_SUPPORTED
	select RUST
	select RUST_ALLOC
	select PSA_CRYPTO
	select CSPRNG_NEEDED
	select PSA_WANT_ALG_PBKDF2_HMAC
	select PSA_WANT_ALG_SHA_512
	select PSA_WANT_ALG_SHA_256
	select PSA_WANT_ALG_RIPEMD160
	select PSA_WANT_ALG_HMAC
	select PSA_WANT_KEY_TYPE_HMAC
	select PSA_WANT_ALG_DETERMINISTIC_ECDSA
	select PSA_WANT_ALG_ECDSA
	select PSA_WANT_ECC_SECP_K1_256
	select PSA_WANT_ECC_SECP_R1_256
	select PSA_WANT_KEY_TYPE_ECC_PUBLIC_KEY
	select PSA_WANT_KEY_TYPE_ECC_KEY_PAIR_DERIVE
	select PSA_WANT_KEY_TYPE_ECC_KEY_PAIR_IMPORT
	select PSA_WANT_KEY_TYPE_ECC_KEY_PAIR_EXPORT
	select PSA_WANT_KEY_TYPE_CHACHA20
	select PSA_WANT_ALG_CHACHA20_POLY1305
	help
	  Build the OSKey Rust application and its PSA wallet backend.
	  Disable this to build the C application without Rust wallet support.

config OSKEY_CORE_STACK_SIZE
	int "OSKey core stack size"
	default 20480 if OSKEY_RUST
	default 2048
	help
	  Stack size for the thread that owns and executes the Rust core.

endmenu

menu "OSKey features"

config OSKEY_STORAGE
	bool "Storage"
	select ZMS
	select SETTINGS
	select FLASH
	select FLASH_MAP
	select FLASH_PAGE_LAYOUT
	help
	  Enable the shared ZMS storage and Zephyr settings backend.

config MPU_ALLOW_FLASH_WRITE
	default y if OSKEY_STORAGE || OSKEY_XIP

config OSKEY_CAMERA
	bool "GC0308 camera"
	depends on SOC_SERIES_ESP32S3
	depends on DT_HAS_GALAXYCORE_GC0308_ENABLED
	depends on DT_HAS_ESPRESSIF_ESP32_LCD_CAM_DVP_ENABLED
	select I2C
	select GPIO
	select VIDEO
	select OSKEY_ESP_SPIRAM
	help
	  Enable the GC0308 sensor and the ESP32-S3 LCD_CAM DVP capture path.

config DMA_ESP32_MAX_DESCRIPTOR_NUM
	default 64 if OSKEY_CAMERA

config VIDEO_BUFFER_USE_SHARED_MULTI_HEAP
	default y if OSKEY_CAMERA

config VIDEO_BUFFER_SMH_ATTRIBUTE
	default 2 if OSKEY_CAMERA

