
config OSKEY_RUST
	bool "OSKey Rust application"
	default y
	depends on RUST_SUPPORTED
	select RUST
	select RUST_ALLOC
	select PSA_CRYPTO
	select PSA_WANT_ALG_PBKDF2_HMAC
	select PSA_WANT_ALG_SHA_512
	select PSA_WANT_ALG_SHA_256
	select PSA_WANT_ALG_RIPEMD160
	select PSA_WANT_ALG_HMAC
	select PSA_WANT_KEY_TYPE_HMAC
	select PSA_WANT_ALG_DETERMINISTIC_ECDSA
	select PSA_WANT_ALG_ECDSA
	select PSA_WANT_ECC_SECP_K1_256
	select PSA_WANT_KEY_TYPE_ECC_PUBLIC_KEY
	select PSA_WANT_KEY_TYPE_ECC_KEY_PAIR_DERIVE
	select PSA_WANT_KEY_TYPE_ECC_KEY_PAIR_IMPORT
	select PSA_WANT_KEY_TYPE_ECC_KEY_PAIR_EXPORT
	select PSA_WANT_KEY_TYPE_CHACHA20
	select PSA_WANT_ALG_CHACHA20_POLY1305
	help
	  Build the OSKey Rust application and its PSA wallet backend.
	  Disable this to build the C application without Rust wallet support.

config LV_Z_DEMO_BENCHMARK
	bool "LVGL benchmark demo"
	select LV_USE_DEMO_BENCHMARK
	select LV_USE_DEMO_WIDGETS
	help
	  Build benchmarking demo application.

menu "Wi-Fi provisioning"
	depends on WIFI && WIFI_USAGE_MODE_STA_AP

config OSKEY_WIFI_AP_SSID
	string "Wi-Fi provisioning AP SSID"
	default "OSKey-AP"

config OSKEY_WIFI_AP_PSK
	string "Wi-Fi provisioning AP password"
	default "12345678"
	help
	  Password for the temporary WPA2 provisioning access point. It must be
	  empty for an open AP or contain 8-63 bytes.

config OSKEY_WIFI_AP_IP_ADDRESS
	string "Wi-Fi provisioning AP IPv4 address"
	default "192.168.4.1"

config OSKEY_WIFI_AP_NETMASK
	string "Wi-Fi provisioning AP IPv4 netmask"
	default "255.255.255.0"

endmenu

menu "MQTT options"
	depends on MQTT_LIB

config OSKEY_MQTT_BROKER_HOSTNAME
	string "MQTT broker hostname"
	default "bemfa.com"

config OSKEY_MQTT_BROKER_PORT
	string "MQTT broker port"
	default "9501"

endmenu

menu "USB options"
	depends on USB_DEVICE_STACK_NEXT

config OSKEY_USBD_MANUFACTURER
	string "USB device manufacturer string"
	default "Butterfly"
	help
	  USB device manufacturer string.

config OSKEY_USBD_PRODUCT
	string "USB device product string"
	default "OSKey"
	help
	  USB device product string.

config OSKEY_USBD_PID
	hex "USB device Product ID"
	default 0x20BF
	help
	  USB device Product ID.

config OSKEY_USBD_SELF_POWERED
	bool "USB device Self-powered attribute"
	default n
	help
	  Set the Self-powered attribute in the USB configuration.

config OSKEY_USBD_REMOTE_WAKEUP
	bool "USB device Remote Wakeup attribute"
	help
	  Set the Remote Wakeup attribute in the USB configuration.

config OSKEY_USBD_MAX_POWER
	int "USB device bMaxPower value"
	default 125
	range 0 250
	help
	  bMaxPower value in the USB configuration in 2 mA units.

config OSKEY_USBD_20_EXTENSION_DESC
	bool "Use default USB 2.0 Extension Descriptor"
	depends on USBD_BOS_SUPPORT
	help
	  Set bcdUSB value to 0201 and use default USB 2.0 Extension Descriptor.

endmenu

source "Kconfig.zephyr"
