config BT_DEVICE_NAME
	default "OSKey"

config BT_L2CAP_TX_MTU
	default 512

config BT_BUF_ACL_TX_SIZE
	default 502

config BT_BUF_ACL_RX_SIZE
	default 502

config BT_BUF_ACL_TX_COUNT
	default 12

config BT_CTLR_DATA_LENGTH_MAX
	default 251

config BT_RX_STACK_SIZE
	default 2048

config SYSTEM_WORKQUEUE_STACK_SIZE
	default 2048

config BT_MAX_PAIRED
	default 3

endif

menuconfig OSKEY_WIFI
	bool "Wi-Fi provisioning"
	select OSKEY_STORAGE
	select WIFI
	select WIFI_NM
	select WIFI_CREDENTIALS
	select WIFI_CREDENTIALS_CONNECT_STORED
	select NETWORKING
	select POSIX_API
	select NET_CONNECTION_MANAGER
	select NET_IPV4
	select NET_L2_WIFI_MGMT
	select NET_SOCKETS
	select NET_TCP
	select NET_UDP
	select NET_HOSTNAME_ENABLE
	select NET_HOSTNAME_DYNAMIC
	select NET_HOSTNAME_UNIQUE
	select NET_DHCPV4
	select NET_DHCPV4_SERVER
	select NET_DHCPV4_SERVER_OPTION_CAPTIVE_PORTAL
	select DNS_RESOLVER
	select HTTP_SERVER
	select HTTP_CLIENT

if OSKEY_WIFI

choice WIFI_USAGE_MODE
	default WIFI_USAGE_MODE_STA_AP
endchoice

choice WIFI_CREDENTIALS_BACKEND
	default WIFI_CREDENTIALS_BACKEND_SETTINGS
endchoice

choice ESP_WIFI_HEAP
	default ESP_WIFI_HEAP_SPIRAM if OSKEY_ESP_SPIRAM
endchoice

