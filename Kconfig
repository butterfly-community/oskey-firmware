menuconfig OSKEY_MQTT
	bool "MQTT"
	depends on NETWORKING
	select POSIX_API
	select NET_CONNECTION_MANAGER
	select NET_IPV4
	select NET_SOCKETS
	select NET_TCP
	select DNS_RESOLVER
	select MQTT_LIB
	select MQTT_CLEAN_SESSION
	help
	  Product capability. Do not remove or disable it merely because current
	  application-level publish/subscribe consumers appear unused.

if OSKEY_MQTT

config OSKEY_MQTT_BROKER_HOSTNAME
	string "MQTT broker hostname"
	default "bemfa.com"

config OSKEY_MQTT_BROKER_PORT
	string "MQTT broker port"
	default "9501"

endif

choice OSKEY_MCUBOOT_BACKEND
	prompt "Signed firmware updates"
	optional

config OSKEY_MCUBOOT_ZEPHYR
	bool "Zephyr MCUboot port"
	select BOOTLOADER_MCUBOOT

config OSKEY_MCUBOOT_ESP
	bool "Espressif MCUboot port"
	depends on SOC_SERIES_ESP32S3
	select BOOTLOADER_MCUBOOT
	select ESP_FLASH_ENCRYPTION

endchoice

config OSKEY_MCUBOOT
	bool
	default y if OSKEY_MCUBOOT_ZEPHYR || OSKEY_MCUBOOT_ESP
	select OSKEY_STORAGE
	select MCUBOOT_BOOTLOADER_NO_DOWNGRADE
	select MCUMGR
	select MCUMGR_GRP_IMG
	select MCUMGR_GRP_OS
	select MCUMGR_GRP_OS_MCUMGR_PARAMS
	select MCUMGR_TRANSPORT_BT if OSKEY_BLUETOOTH
	select UART_MCUMGR
	select MCUMGR_TRANSPORT_UART
	select BASE64
	select ZCBOR
	select CRC
	select IMG_MANAGER
	select IMG_ERASE_PROGRESSIVELY
	select STREAM_FLASH
	help
	  Enable signed MCUboot updates over authenticated Bluetooth, or over UART
	  after the application explicitly reboots into firmware update mode.

config MCUBOOT_GENERATE_UNSIGNED_IMAGE
	default n if OSKEY_MCUBOOT_ESP

config MCUBOOT_SIGNATURE_KEY_FILE
	default "$(APP_DIR)/sign/root-ec-p256.pem" if OSKEY_MCUBOOT_ESP

config OSKEY_MCUBOOT_ESP_VIRTUAL_EFUSE
	bool "Use virtual eFuses"
	depends on OSKEY_MCUBOOT_ESP
	default y
	select ESP32_EFUSE_VIRTUAL
	select ESP32_EFUSE_VIRTUAL_KEEP_IN_FLASH
	help
	  Persist simulated eFuses in flash so Secure Boot and flash encryption
	  flows can be tested without changing the chip's real eFuses.

if OSKEY_MCUBOOT

config MCUMGR_TRANSPORT_BT_CONN_PARAM_CONTROL
	default y if OSKEY_BLUETOOTH

endif

config OSKEY_XIP
	bool "Execute in place"

if OSKEY_XIP

config XIP
	default y

endif

endmenu

menu "OSKey development options"

config OSKEY_LOG
	bool "Logging"
	select NET_LOG if NETWORKING

config LOG
	default y if OSKEY_LOG
	default n

config BOOT_BANNER
	default n if OSKEY_DEBUG
	default y if OSKEY_LOG
	default n

config OSKEY_DEBUG
	bool "Debugging"
	select DEBUG
	select STACK_USAGE
	select STATS

config OSKEY_CAMERA_TEST
	bool "GC0308 live preview test"
	depends on OSKEY_CAMERA
	select DISPLAY
	help
	  Replace the normal application startup with a camera-to-display preview loop.

config OSKEY_TEST_RNG
	bool "Insecure test random generator"
	select TEST_RANDOM_GENERATOR

if OSKEY_TEST_RNG

config MBEDTLS_PSA_CRYPTO_EXTERNAL_RNG_ALLOW_NON_CSPRNG
	default y

choice RNG_GENERATOR_CHOICE
	default TIMER_RANDOM_GENERATOR
endchoice

endif

config OSKEY_ESP_SPIRAM
	bool "ESP32 external SPI RAM"
	depends on SOC_SERIES_ESP32 || SOC_SERIES_ESP32S3
	select ESP_SPIRAM
	select RUST_ALLOC_ESP_SPIRAM if OSKEY_RUST
	select SPIRAM_FETCH_INSTRUCTIONS if SOC_SERIES_ESP32S3
	select SPIRAM_RODATA if SOC_SERIES_ESP32S3
endmenu

