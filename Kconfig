	default "OSKey-"

config NET_IF_MAX_IPV4_COUNT
	default 2

config NET_MAX_CONN
	default 8

config NET_BUF_RX_COUNT
	default 100

config NET_BUF_TX_COUNT
	default 100

config NET_MGMT_EVENT_QUEUE_SIZE
	default 10

config NET_MGMT_EVENT_STACK_SIZE
	default 4096

config HTTP_SERVER_VERSION_2
	default n

config HTTP_SERVER_MAX_CLIENTS
	default 1

config ZVFS_EVENTFD_MAX
	default 2

config ESP32_WIFI_NET_ALLOC_SPIRAM
	default y if OSKEY_ESP_SPIRAM

config OSKEY_WIFI_AP_SSID
	string "Wi-Fi provisioning AP SSID"
	default "OSKey-AP"

config OSKEY_WIFI_AP_PSK
	string "Wi-Fi provisioning AP password"
	default "12345678"
	help
	  Password for the temporary WPA2 provisioning access point. It must be
	  empty for an open AP or contain 8-63 bytes.

config OSKEY_WIFI_AP_IP_ADDRESS
	string "Wi-Fi provisioning AP IPv4 address"
	default "192.168.4.1"

config OSKEY_WIFI_AP_NETMASK
	string "Wi-Fi provisioning AP IPv4 netmask"
	default "255.255.255.0"

endif

menuconfig OSKEY_USB
	bool "USB"
	select USB_DEVICE_STACK_NEXT
	select UART_LINE_CTRL

if OSKEY_USB

config ESP_USB_SERIAL_JTAG_ENABLED
	default n

config CDC_ACM_SERIAL_INITIALIZE_AT_BOOT
	default n

choice USBD_LOG_LEVEL_CHOICE
	default USBD_LOG_LEVEL_WRN
endchoice

choice UDC_DRIVER_LOG_LEVEL_CHOICE
	default UDC_DRIVER_LOG_LEVEL_WRN
endchoice

config OSKEY_USBD_MANUFACTURER
	string "USB device manufacturer string"
	default "Butterfly"
	help
	  USB device manufacturer string.

config OSKEY_USBD_PRODUCT
	string "USB device product string"
	default "OSKey"
	help
	  USB device product string.

config OSKEY_USBD_PID
	hex "USB device Product ID"
	default 0x20BF
	help
	  USB device Product ID.

config OSKEY_USBD_SELF_POWERED
	bool "USB device Self-powered attribute"
	help
	  Set the Self-powered attribute in the USB configuration.

config OSKEY_USBD_REMOTE_WAKEUP
	bool "USB device Remote Wakeup attribute"
	help
	  Set the Remote Wakeup attribute in the USB configuration.

config OSKEY_USBD_MAX_POWER
	int "USB device bMaxPower value"
	default 125
	range 0 250
	help
	  bMaxPower value in the USB configuration in 2 mA units.

config OSKEY_USBD_20_EXTENSION_DESC
	bool "Use default USB 2.0 Extension Descriptor"
	depends on USBD_BOS_SUPPORT
	default y
	help
	  Set bcdUSB value to 0201 and use default USB 2.0 Extension Descriptor.

endif

config OSKEY_FIDO2
	bool "FIDO2 authenticator"
	depends on OSKEY_RUST
	select OSKEY_STORAGE
	select OSKEY_USB
	select FIDO2
	select FIDO2_CREDENTIALS_CUSTOM
	select FIDO2_CREDENTIALS_BACKUP_ELIGIBLE
	select FIDO2_TRANSPORT_USB_HID
	help
	  Enable the USB FIDO2 authenticator for OpenSSH and other FIDO2 clients.

if OSKEY_FIDO2

choice FIDO2_UP_BACKEND
	default FIDO2_UP_CUSTOM
endchoice

choice FIDO2_STORAGE_BACKEND
	default FIDO2_STORAGE_SETTINGS
endchoice

choice FIDO2_ATTESTATION_BACKEND
	default FIDO2_ATTESTATION_NONE
endchoice

config FIDO2_AAGUID
	default "8e0d2cfc850153abb0b523751d20e730"

endif

